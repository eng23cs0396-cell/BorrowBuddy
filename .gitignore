# Root .gitignore for the repository

# Node modules
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid

# Environment files (keep examples)
.env
.env.local
.env.*.local
!.env.example

# Uploads and user-generated content
backend/uploads/

# Build outputs
dist/
build/
frontend/dist/

# Dependency lockfiles (optional - remove if you commit lockfiles)
pnpm-lock.yaml
package-lock.json
yarn.lock

# Coverage and reports
coverage/
.nyc_output/

# IDEs and editors
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temp
tmp/
temp/
.cache/

# Misc
*.swp
*.swo
